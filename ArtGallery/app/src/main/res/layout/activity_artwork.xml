<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/gallery_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Artwork Detail Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@color/gallery_card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Large Artwork Image -->
                <ImageView
                    android:id="@+id/largeArtworkImage"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/artwork_image"/>

                <!-- Content -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/largeArtworkTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Artwork Title"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:textColor="@color/gallery_text_primary"/>

                    <!-- Artist -->
                    <TextView
                        android:id="@+id/largeArtistName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Artist"
                        android:textSize="18sp"
                        android:textColor="@color/gallery_primary"
                        android:layout_marginTop="8dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gallery_divider"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="20dp"/>

                    <!-- Description Section Header -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ABOUT THE ARTWORK"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.2"
                        android:textColor="@color/gallery_text_secondary"/>

                    <!-- Description -->
                    <TextView
                        android:id="@+id/largeDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Complete artwork description."
                        android:textSize="16sp"
                        android:textColor="@color/gallery_text_secondary"
                        android:lineSpacingExtra="8dp"
                        android:layout_marginTop="10dp"/>

                    <!-- Favorite Button -->
                    <Button
                        android:id="@+id/favoriteButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="❤  ADD TO FAVORITES"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textSize="14sp"
                        android:textColor="@color/gallery_selected_tab_text"
                        android:background="@drawable/bg_button"
                        android:elevation="6dp"
                        android:layout_marginTop="32dp"/>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
