<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_main_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp">

        <!-- Header -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NOTIFICATION"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.10" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="CENTER"
            android:textAlignment="center"
            android:textColor="#D8B4FE"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.16" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Academic Notification System"
            android:textAlignment="center"
            android:textColor="#DDD6EA"
            android:textSize="14sp" />

        <!-- Notification Icon -->

        <LinearLayout
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_gravity="center"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:background="@drawable/bg_notification_icon">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔"
                android:textSize="34sp" />

        </LinearLayout>

        <!-- Main Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/bg_notification_card"
            android:elevation="8dp">

            <!-- Section Heading -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notification Details"
                android:textColor="#29243D"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Create an academic notification"
                android:textColor="#777187"
                android:textSize="13sp" />

            <!-- Notification Type Label -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Notification Type"
                android:textColor="#403951"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Notification Type -->

            <Spinner
                android:id="@+id/spinnerNotificationType"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_notification_status"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:spinnerMode="dropdown" />

            <!-- Notification Title Label -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Notification Title"
                android:textColor="#403951"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Notification Title -->

            <EditText
                android:id="@+id/etNotificationTitle"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:hint="Enter notification title"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#29243D"
                android:textColorHint="#9995A5"
                android:textSize="15sp"
                android:background="@drawable/bg_notification_status" />

            <!-- Message Content Label -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Message Content"
                android:textColor="#403951"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Message Content -->

            <EditText
                android:id="@+id/etNotificationMessage"
                android:layout_width="match_parent"
                android:layout_height="115dp"
                android:layout_marginTop="8dp"
                android:gravity="top|start"
                android:hint="Student: Name | USN: XXXXX | Enter notification details..."
                android:inputType="textCapSentences|textMultiLine"
                android:padding="16dp"
                android:textColor="#29243D"
                android:textColorHint="#9995A5"
                android:textSize="14sp"
                android:background="@drawable/bg_notification_status" />

            <!-- Priority Label -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Notification Priority"
                android:textColor="#403951"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Priority -->

            <Spinner
                android:id="@+id/spinnerPriority"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_notification_status"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:spinnerMode="dropdown" />

            <!-- Send Button -->

            <Button
                android:id="@+id/btnSendNotification"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="26dp"
                android:text="SEND NOTIFICATION"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:background="@drawable/bg_status_icon" />

        </LinearLayout>

        <!-- Footer -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Secure • Fast • Academic Communication"
            android:textAlignment="center"
            android:textColor="#D8D2E5"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>